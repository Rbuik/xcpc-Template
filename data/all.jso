        "title": "树的直径与重心",
        "description": "两次DFS求直径，求点权/边权重心。",
        "code": "最长直径\nvoid dfs(int u,int pa,int len){\n    if(len>MaxLen){ MaxLen=len; l=u; }\n    for(auto g:G[u]){\n        int v=g.first,w=g.second;\n        if(v==pa) continue;\n        dfs(v,u,len+w);\n    }\n}\n\n点权重心\nvoid dfs(int u,int pa){\n    dp[u]=1; int sum=0;\n    for(int v:G[u]){\n        sum=max(sum,dp[v]);\n    }\n    sum=max(sum,n-dp[u]);\n    ans=min(ans,sum);\n}"
    }
